; RoadShift — Open World Delivery & Driving Simulator.
config_version=5

[application]
config/name="RoadShift"
config/description="RoadShift — Open World Delivery & Driving Simulator"
config/version="0.1.1"
; Preserve the existing development profile when changing the product name.
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/Harborline Dispatch"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=1024
environment/defaults/default_clear_color=Color(0.48, 0.64, 0.7, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=9.81

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/untyped_declaration=0
